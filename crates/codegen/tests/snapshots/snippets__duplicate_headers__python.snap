import requests

url = "https://api.test/dupes"
# NOTE: requests takes headers as a mapping, so 2 repeated header names cannot be
# represented here and only the last value of each is sent: Accept, X-Sig
headers = {
    "Accept": "application/json",
    "Accept": "text/plain; q=0.5",
    "X-Sig": "first",
    "X-Sig": "second",
    "X-Ts": "1699999999",
}

response = requests.request("GET", url, headers=headers)
print(response.status_code)
print(response.text)
