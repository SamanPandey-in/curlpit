import requests

url = "https://api.test/users"
headers = {
    "Content-Type": "application/json",
}
data = "{\n  \"name\": \"Ada\",\n  \"tags\": [1, 2, 3],\n  \"ok\": true\n}"

response = requests.request("POST", url, headers=headers, data=data.encode("utf-8"))
print(response.status_code)
print(response.text)
