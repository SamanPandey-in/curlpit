const response = await fetch("https://api.test/headers", {
  method: "GET",
  headers: {
    "X-Quote": "he said \"hi\" and it's 'fine'",
    "X-Dollar": "cost $5 {$x} ${y} `tick`",
    "X-Backslash": "C:\\path\\to\\thing",
  },
});

console.log(response.status);
console.log(await response.text());
