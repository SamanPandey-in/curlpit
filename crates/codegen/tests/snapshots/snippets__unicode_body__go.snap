expression: "generate(b, lang)"
---
package main

import (
	"fmt"
	"io"
	"net/http"
	"strings"
)

func main() {
	req, err := http.NewRequest("POST", "https://api.test/unicode", strings.NewReader("{\"emoji\": \"😀🏳️‍🌈\", \"zwj\": \"👨‍👩‍👧\", \"math\": \"𝒳𝓇\", \"combining\": \"école\", \"cjk\": \"漢字\", \"rtl\": \"مرحبا\"}"))
	if err != nil {
		panic(err)
	}
	req.Header.Add("X-Emoji", "😀")
	req.Header.Add("Content-Type", "application/json")

	resp, err := http.DefaultClient.Do(req)
	if err != nil {
		panic(err)
	}
	defer resp.Body.Close()
	out, _ := io.ReadAll(resp.Body)
	fmt.Println(resp.Status)
	fmt.Println(string(out))
}
