<?php

$ch = curl_init();
curl_setopt_array($ch, [
    CURLOPT_URL => "https://up.test/batch",
    CURLOPT_CUSTOMREQUEST => "POST",
    CURLOPT_RETURNTRANSFER => true,
    // NOTE: a PHP array has unique keys, so 2 repeated part names cannot be
    // represented here and only the last value of each is sent: tag, files[]
    CURLOPT_POSTFIELDS => [
        "tag" => "one",
        "tag" => "two",
        "files[]" => new CURLFile("/tmp/a.png"),
        "files[]" => new CURLFile("/tmp/b.png"),
    ],
]);

$response = curl_exec($ch);
$status = curl_getinfo($ch, CURLINFO_RESPONSE_CODE);
curl_close($ch);

echo $status, "\n";
echo $response, "\n";
