<?php

$ch = curl_init();
curl_setopt_array($ch, [
    CURLOPT_URL => "https://api.test/resource",
    CURLOPT_CUSTOMREQUEST => "HEAD",
    CURLOPT_RETURNTRANSFER => true,
    CURLOPT_NOBODY => true,
    CURLOPT_HTTPHEADER => [
        "If-None-Match: \"etag-1\"",
    ],
]);

$response = curl_exec($ch);
$status = curl_getinfo($ch, CURLINFO_RESPONSE_CODE);
curl_close($ch);

echo $status, "\n";
echo $response, "\n";
