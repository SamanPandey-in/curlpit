expression: "generate(b, lang)"
---
package main

import (
	"bytes"
	"fmt"
	"io"
	"mime/multipart"
	"net/http"
	"os"
	"path/filepath"
)

func main() {
	var buf bytes.Buffer
	w := multipart.NewWriter(&buf)
	w.WriteField("note", "it's \"fine\" $here")
	{
		f, err := os.Open("/tmp/a b's \"file\".png")
		if err != nil {
			panic(err)
		}
		part, err := w.CreateFormFile("upload", filepath.Base("/tmp/a b's \"file\".png"))
		if err != nil {
			panic(err)
		}
		io.Copy(part, f)
		f.Close()
	}
	w.Close()

	req, err := http.NewRequest("PUT", "https://up.test/u", &buf)
	if err != nil {
		panic(err)
	}
	req.Header.Set("Content-Type", w.FormDataContentType())

	resp, err := http.DefaultClient.Do(req)
	if err != nil {
		panic(err)
	}
	defer resp.Body.Close()
	out, _ := io.ReadAll(resp.Body)
	fmt.Println(resp.Status)
	fmt.Println(string(out))
}
