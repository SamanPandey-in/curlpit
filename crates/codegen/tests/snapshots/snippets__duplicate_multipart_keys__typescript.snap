import { openAsBlob } from "node:fs";

const form: FormData = new FormData();
form.append("tag", "one");
form.append("tag", "two");
form.append("files[]", await openAsBlob("/tmp/a.png"), "a.png");
form.append("files[]", await openAsBlob("/tmp/b.png"), "b.png");

const url = "https://up.test/batch";

const options: RequestInit = {
  method: "POST",
  body: form,
};

const res: Response = await fetch(url, options);
console.log(res.status);
console.log(await res.text());
