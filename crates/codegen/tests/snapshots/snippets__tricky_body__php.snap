<?php

$ch = curl_init();
curl_setopt_array($ch, [
    CURLOPT_URL => "https://api.test/tricky",
    CURLOPT_CUSTOMREQUEST => "POST",
    CURLOPT_RETURNTRANSFER => true,
    CURLOPT_HTTPHEADER => [
        "X-Tricky: v\x01alue\twith\ttabs",
        "Content-Type: text/plain",
    ],
    CURLOPT_POSTFIELDS => "single ' double \" backtick ` dollar \$ interp {\$var} brace \${var}\nplaceholder {{notavar}} backslash \\ not-an-escape \\n \\x41 \\u{41}\ntab\there\ttwo\tvertical\vform\fescape\e[0m\nsoh\x01del\x7fdone",
]);

$response = curl_exec($ch);
$status = curl_getinfo($ch, CURLINFO_RESPONSE_CODE);
curl_close($ch);

echo $status, "\n";
echo $response, "\n";
