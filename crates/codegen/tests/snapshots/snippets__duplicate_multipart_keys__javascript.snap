import fs from "node:fs";

const form = new FormData();
form.append("tag", "one");
form.append("tag", "two");
form.append("files[]", await fs.openAsBlob("/tmp/a.png"), "a.png");
form.append("files[]", await fs.openAsBlob("/tmp/b.png"), "b.png");

const response = await fetch("https://up.test/batch", {
  method: "POST",
  body: form,
});

console.log(response.status);
console.log(await response.text());
