import fs from "node:fs";

const form = new FormData();
form.append("note", "it's \"fine\" $here");
form.append("upload", await fs.openAsBlob("/tmp/a b's \"file\".png"), "a b's \"file\".png");

const response = await fetch("https://up.test/u", {
  method: "PUT",
  body: form,
});

console.log(response.status);
console.log(await response.text());
